<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MediaHub is dark-only: the same dark launch screen in light and dark system mode,
         so there is never a white flash before the first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/mediahub_canvas</item>
        <item name="android:navigationBarColor">@color/mediahub_canvas</item>
    </style>
    <!-- Window colour behind the Flutter UI while it runs (e.g. during rotation / PiP). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/mediahub_canvas</item>
    </style>
</resources>
